# Hedgeye Bot — Environment Variables
# Copy this file to .env and fill in your values
# NEVER share this file or commit it to GitHub

# ── iCloud Email (IMAP) ────────────────────────────────────────
ICLOUD_EMAIL=Bogacki20@icloud.com
# Generate an app-specific password at: https://appleid.apple.com
# Go to: Sign-In & Security → App-Specific Passwords → Generate
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Anthropic (Claude API) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Pushover (push notifications) ─────────────────────────────
# Sign up at: https://pushover.net
# PUSHOVER_TOKEN: your application's API token (create one under "Your Applications")
# PUSHOVER_USER:  your user key (shown on the main dashboard after login)
PUSHOVER_TOKEN=azGDORePK8gMaC0QOYAMyEEuzJnyUi
PUSHOVER_USER=uQiRzpo4DXghDmr9QzzfQu

# ── Hedgeye Quad regime (manual, canonical) ───────────────────
# The operator sets these after reading the Hedgeye Macro Show.
# Format: "Quad 1" / "Quad 2" / "Quad 3" / "Quad 4"
# QUARTERLY drives the strategic universe; MONTHLY drives the tactical lens.
# Both default to "Quad 1" with a loud log warning if unset.
CURRENT_QUARTERLY_QUAD_OVERRIDE=Quad 3
CURRENT_MONTHLY_QUAD_OVERRIDE=Quad 2
# QUAD_AUTODETECT=1 re-enables tools/detect_quads.py (off by default 2026-05-24)
# QUAD_AUTODETECT=0

# ── Price feed (yfinance ↔ ibkr ↔ polygon) ────────────────────
# PRICE_FEED=yfinance is the default. Set to 'ibkr' once the ibkr-gateway
# Railway service is up (see deploy/ibkr-gateway/README.md). Both ibkr and
# polygon fall back to yfinance on ANY error — the bot can never panic on
# a market-data outage.
# PRICE_FEED=yfinance
# IBKR_GATEWAY_URL=http://ibkr-gateway.railway.internal:5000
# POLYGON_API_KEY=         # legacy / fallback only — Polygon kept as dead code

# ── Scanner cadence ───────────────────────────────────────────
# SCAN_CYCLE_SECONDS=900   # default 15 min between cycles

# ── Optional Settings ──────────────────────────────────────────
# How often to scrape portal (seconds). Default: 900 = 15 minutes
SCRAPE_INTERVAL_SECONDS=900
# How often to check email (seconds). Default: 900 = 15 minutes
EMAIL_CHECK_INTERVAL=900
# Hour (ET) to send morning brief. Default: 7 = 7:00am
MORNING_BRIEF_HOUR=7
# Database file path (Railway provides /data as persistent volume)
DB_PATH=/data/hedgeye.db
